{
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db-reset": "npx prisma migrate reset && npx prisma db seed",
    "import-song": "npx tsx prisma/import-song.ts",
    "db:backup": "docker-compose exec -T postgres pg_dump -U songmatchup --data-only --no-owner --inserts --on-conflict-do-nothing -t '\"Song\"' songmatchup_dev > prisma/backup.sql",
    "db:restore-prod": "psql \"$PROD_DATABASE_URL\" < prisma/backup.sql",
    "cron:trigger": "curl -s http://localhost:3000/api/cron/daily-matchup -H \"Authorization: Bearer $CRON_SECRET\" | cat"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.5",
    "postcss": "^8.5.14",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.5",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-youtube": "^10.1.0"
  }
}
